# Optional Discord webhook for reports. Leave unset to print locally.
DEFLAMA_WEBHOOK_URL=

# Optional overrides
# TRACKER_DB_PATH=
# TRACKER_CHECK_INTERVAL=6
# TRACKER_TOP_N=10
# TRACKER_ANOMALY_THRESHOLD=50

# --- Memecoin activity ---
# Comma-separated memecoin symbols to track
# TRACKER_MEMECOINS=PEPE,WIF,BONK,DOGE,SHIB,FLOKI,POPCAT,BRETT,MOG
# DeFiLlama categories that count as memecoin infrastructure
# TRACKER_MEME_CATEGORIES=Launchpad,Meme,MemeDex
# Min 24h volume (USD) for a memecoin to count as "real" activity
# TRACKER_MEME_VOLUME_FLOOR=25000
# How many top holders to resolve for the top-wallets section
# TRACKER_TOP_HOLDERS=10
# Comma-separated public Solana RPC endpoints (free, best-effort)
# TRACKER_SOLANA_RPCS=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com,https://solana.drpc.org
